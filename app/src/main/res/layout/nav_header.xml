<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="0dp"
    android:fitsSystemWindows="false"
    android:paddingTop="60dp"
    android:paddingBottom="8dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/drawer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/marginHorizontal"
        android:text="@string/start_title"
        android:layout_marginBottom="24dp"
        style="@style/StartScreenTitleStyle"/>

    <ImageView
        android:id="@+id/app_logo"
        android:layout_width="97dp"
        android:layout_height="9.5dp"
        android:layout_gravity="start"
        android:layout_marginHorizontal="13dp"
        android:foregroundGravity="left"
        app:srcCompat="@drawable/app_logo_menu"
        app:tint="@color/medium_blue" />


    <!--androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawer_menu_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        tools:listitem="@layout/item_drawer_notebook" /-->
</LinearLayout>