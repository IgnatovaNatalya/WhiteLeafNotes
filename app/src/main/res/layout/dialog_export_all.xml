<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/marginHorizontal"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/export_dialog_title"
        android:textAppearance="@style/DialogTitle"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/export_dialog_subtitle"
        android:textAppearance="@style/DialogSubtitle"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/path_to_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:textAppearance="@style/DialogTextBold"
        android:textColor="?android:attr/textColorPrimary"
        app:drawableStartCompat="@drawable/ic_folder"
        app:drawableTint="?android:attr/textColorPrimary"
        tools:text="Загрузки" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_share_zip"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="8dp"
        android:checked="true"
        android:text="@string/share_file"
        android:textAppearance="@style/DialogText"
        app:thumbTint="@drawable/switch_thumb_selector"
        app:trackTint="@drawable/switch_track_selector" />

    <LinearLayout
        android:id="@+id/ll_export_encrypted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/export_encrypted"
                android:textAppearance="@style/DialogText" />

            <TextView
                android:id="@+id/tv_export_encrypted_text"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:textAppearance="@style/DialogSubtitle"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="2 объекта потребуют биометрию" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_export_encrypted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:checked="true"
            app:thumbTint="@drawable/switch_thumb_selector"
            app:trackTint="@drawable/switch_track_selector" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_set_password"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:checked="false"
        android:text="@string/set_password"
        android:textAppearance="@style/DialogText"
        app:thumbTint="@drawable/switch_thumb_selector"
        app:trackTint="@drawable/switch_track_selector" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="0dp"
        android:visibility="visible"
        app:boxStrokeWidth="0dp"
        app:endIconMode="password_toggle"
        app:endIconTint="?android:attr/textColorSecondary"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="0dp"
            android:background="@drawable/bg_rounded_corners"
            android:drawableStart="@drawable/ic_edit"
            android:drawablePadding="8dp"
            android:hint="@string/export_zip_password"
            android:inputType="textPassword"
            android:textAppearance="@style/DialogText" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>