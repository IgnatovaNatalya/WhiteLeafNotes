<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- TOOLBAR-->

    <style name="StartScreenTitleStyle">
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">@font/comfortaa_bold</item>
        <item name="textAllCaps">false</item>
        <item name="lineHeight">30sp</item>
        <item name="android:textColor">@color/medium_blue</item>
    </style>

    <style name="toolbarTitleStyle" parent="@style/Base.TextAppearance.AppCompat.Title">
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:textColor">?attr/android:textColorPrimary</item>
    </style>

    <style name="toolbarSubtitleStyle" parent="@style/Base.TextAppearance.AppCompat.Title">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
        <item name="android:textColor">?attr/android:textColorSecondary</item>
    </style>

    <!-- START SCREEN -->

    <style name="StartScreenItemTitle">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="lineHeight">16dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="StartScreenItemNotebookCount">
        <item name="android:textSize">10sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
        <item name="textAllCaps">false</item>
        <item name="lineHeight">10dp</item>
    </style>

    <style name="StartScreenItemAdd">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="StartScreenItemHeader">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nunito_bold</item>
    </style>

    <style name="StartScreenItemDate">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
    </style>

    <style name="StartScreenItemEmpty">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
    </style>

    <!-- DRAWER MENU -->

    <style name="DrawerItemStyle">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
        <item name="android:typeface">normal</item>
        <item name="textAllCaps">false</item>
    </style>

    <!--NOTE EDIT-->

    <style name="NoteEditTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
        <item name="fontFamily">@font/nunito_bold</item>
    </style>

    <style name="NoteEditDate">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
    </style>

    <style name="NoteEditText">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="fontFamily">@font/nunito_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="CustomDatePickerHeader" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>

    <style name="CustomMaterialCalendarTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="materialCalendarHeaderTitle">@style/CustomDatePickerHeader</item>

    </style>

    <style name="CustomDatePickerDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <!-- Изменяем размер шрифта даты (работает нестабильно) -->
        <item name="android:textSize">14sp</item>
        <!-- Изменяем цвет текста -->
        <item name="android:fontFamily">@font/nunito_medium</item>
    </style>

    <!--PLANNER-->
    <style name="NotePlanerDate">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
        <item name="android:textColor">?attr/android:textColorSecondary</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="NotePlanerTitle">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="textAllCaps">false</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textColor">?attr/android:textColorPrimary</item>
    </style>


    <!--DIALOG-->
    <style name="WhiteLeafDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:backgroundTint">?attr/colorPrimarySurface</item>
        <item name="buttonBarPositiveButtonStyle">@style/Alert.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Alert.Button.Negative</item>
        <item name="android:windowMinWidthMajor">40%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="DialogTitle">
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">@font/comfortaa_bold</item>
    </style>

    <style name="DialogSubtitle">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
    </style>

    <style name="DialogText">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/nunito_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DialogTextBold">
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">@font/nunito_bold</item>
    </style>

    <style name="WhiteLeafChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/CustomChipTextAppearance</item>
        <item name="chipBackgroundColor">@color/chip_background_color_selector</item>
        <item name="android:textColor">@color/chip_text_color_selector</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeColor">@color/accent_coral</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <style name="CustomChipTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito_medium</item>
    </style>

    <style name="Alert.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/button_positive_text_color_selector</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Alert.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>






    <!-- -->
    <style name="SwitchStyle">
        <item name="android:thumb">@drawable/switch_thumb_selector</item>
        <item name="trackTint">@drawable/switch_track_selector</item>
        <item name="thumbTint">@drawable/switch_thumb_selector</item>
    </style>

    <style name="PopupItem" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">?attr/android:textColorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nunito_medium</item>
        <item name="android:background">@drawable/popup_menu_item_background</item>
    </style>

</resources>